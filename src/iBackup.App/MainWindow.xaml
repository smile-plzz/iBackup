<Window
    x:Class="iBackup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iBackup.App"
    xmlns:tb="using:H.NotifyIcon"
    Title="iBackup">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- System Tray Notification Icon -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="iBackup - iOS Media Backup"
            IconSource="/Assets/iBackup.ico"
            LeftClickCommand="{x:Bind ShowWindowCommand}" />

        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1000"
            IsSettingsVisible="False">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,16,0,24">
                    <Image Source="ms-appx:///Assets/iBackup-icon.png" Width="32" Height="32" AutomationProperties.Name="iBackup" />
                    <TextBlock Text="iBackup" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Backup" Tag="main">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
