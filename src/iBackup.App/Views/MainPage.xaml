<Page
    x:Class="iBackup.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:iBackup.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer MaxWidth="848" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Margin="24,32,24,32" Spacing="16">

            <!-- Title Header -->
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Your memories. Kept close." Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Back up photos and videos to your own drive."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
                     Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                     IsClosable="True" />

            <!-- 1. Device Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <!-- Connected State -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE8EA;" FontSize="36" Margin="0,0,16,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ConnectedDevice.Name, Mode=OneWay, FallbackValue='Apple Device'}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Keep your device unlocked during backup." Style="{StaticResource SupportingTextStyle}" FontSize="12" />
                            </StackPanel>

                            <!-- Connection Status Badge -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Connected" FontWeight="Medium" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Disconnected State -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE8EA;" FontSize="36" Margin="0,0,16,0" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Connect your iPhone" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Connect by USB, unlock it, and tap Trust if asked."
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <Ellipse Width="10" Height="10" Fill="#8A8886" />
                                <TextBlock Text="Disconnected" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Destination Section -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Save to" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{x:Bind ViewModel.DestinationPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Choose a backup folder" AutomationProperties.Name="Backup folder" MinHeight="40"
                                 VerticalAlignment="Center" />

                        <Button Grid.Column="1" Click="BrowseDestinationButton_Click" VerticalAlignment="Center" MinHeight="40" AutomationProperties.Name="Choose backup folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xED25;" FontSize="16" />
                                <TextBlock Text="Choose…" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Backup Status Card -->
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Backup" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{x:Bind ViewModel.ActivityStage, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"
                                  TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Progress Bar -->
                    <ProgressBar AutomationProperties.Name="Backup progress" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                 Maximum="100"
                                 Height="6"
                                 CornerRadius="4" />

                    <!-- Detailed Metrics -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Files -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Files" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.FilesProgress, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Bytes -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Transferred" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BytesProgress, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Estimated Remaining -->
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Time left" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.EstimatedTimeRemaining, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Action Buttons -->
            <StackPanel Spacing="12">
                <Button Style="{StaticResource PrimaryActionStyle}"
                        Command="{x:Bind ViewModel.StartBackupCommand}"
                        MinWidth="160" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBackingUp, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <FontIcon Glyph="&#xE768;" FontSize="16"
                                  Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                        <TextBlock Text="{x:Bind ViewModel.StartButtonText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.PauseResumeCommand}" Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.PauseResumeButtonText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.CancelBackupCommand}" Visibility="{x:Bind ViewModel.IsBackingUp, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                        <TextBlock Text="Cancel" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 5. Last Backup Summary Line -->
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12"
                    Padding="12,10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.LastBackupSummary, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Support and diagnostics -->
            <Expander Header="Help &amp; diagnostics" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10" Padding="0,8,0,4">
                    <TextBlock Text="Unlock the iPhone, tap Trust This Computer, keep the screen awake, and confirm Apple Devices or iTunes is installed."
                              TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Spacing="8">
                        <Button Content="Open backup folder" Command="{x:Bind ViewModel.OpenDestinationCommand}" />
                        <Button Content="Open diagnostic logs" Command="{x:Bind ViewModel.OpenLogsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 6. Checkbox Toggles -->
            <StackPanel Spacing="8">
                <CheckBox Content="Back up automatically when connected"
                          IsChecked="{x:Bind ViewModel.AutoBackupOnConnect, Mode=TwoWay}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
