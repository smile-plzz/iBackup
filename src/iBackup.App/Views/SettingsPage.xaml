<Page
    x:Class="iBackup.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxWidth="848" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Margin="24,32,24,32" Spacing="16">
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Simple by default." Style="{StaticResource SupportingTextStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Backup preferences" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Choose your folder and automatic-backup preference on the Backup page. This preview uses the defaults below."
                               Style="{StaticResource SupportingTextStyle}" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="Organized by year and month" FontWeight="SemiBold" />
                    <TextBlock Text="Files are saved in dated folders, such as 2026 / 10. Existing destination files are never overwritten."
                               Style="{StaticResource SupportingTextStyle}" />
                    <TextBlock Text="Photos and videos" FontWeight="SemiBold" />
                    <TextBlock Text="Supported photo, video, RAW, and screenshot files available over USB are included. Your phone's originals stay untouched."
                               Style="{StaticResource SupportingTextStyle}" />
                    <TextBlock Text="Copy checks" FontWeight="SemiBold" />
                    <TextBlock Text="Copied file sizes are checked and SHA-256 hashes are recorded. This is not a source-to-copy hash comparison."
                               Style="{StaticResource SupportingTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Preview scope" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Custom organization, media filters, starting with Windows, and minimizing to the tray are not yet connected to the app's backup flow. They are not offered as active settings in this release."
                               Style="{StaticResource SupportingTextStyle}" />
                    <TextBlock Text="iBackup copies photos and videos. It does not create a full iPhone restore backup."
                               Style="{StaticResource SupportingTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="ms-appx:///Assets/iBackup-icon.png" Width="40" Height="40" AutomationProperties.Name="iBackup icon" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="iBackup" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Style="{StaticResource SupportingTextStyle}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Your memories, on your own drive. No account or cloud required."
                               Style="{StaticResource SupportingTextStyle}" />
                    <HyperlinkButton Content="Project &amp; release notes" NavigateUri="{x:Bind ViewModel.GitHubUrl, Mode=OneWay}" Padding="0,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
