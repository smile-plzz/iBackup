<Page
    x:Class="iBackup.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Margin="32,24,32,32" Spacing="20">

            <!-- Title Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Configure backup storage structure, media filtering, and startup options."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 1. File Organization Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="File Organization" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Choose how media files are organized into directories on your backup drive."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedOrganizationIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="By Year and Month (e.g. 2026\10\IMG_0001.JPG)" />
                        <ComboBoxItem Content="By Year, Month, and Day (e.g. 2026\10\13\IMG_0001.JPG)" />
                        <ComboBoxItem Content="Flat (All files directly inside destination folder)" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 2. File Types Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Media Types to Back Up" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Select which media formats and categories to include during scanning."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Spacing="8">
                        <CheckBox Content="Photos (JPEG, HEIC, PNG)"
                                  IsChecked="{x:Bind ViewModel.BackupPhotos, Mode=TwoWay}" />
                        <CheckBox Content="Videos (MOV, MP4, M4V)"
                                  IsChecked="{x:Bind ViewModel.BackupVideos, Mode=TwoWay}" />
                        <CheckBox Content="RAW Photos (Apple ProRAW, DNG)"
                                  IsChecked="{x:Bind ViewModel.BackupRaw, Mode=TwoWay}" />
                        <CheckBox Content="Screenshots"
                                  IsChecked="{x:Bind ViewModel.BackupScreenshots, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Verify Integrity Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Verify integrity after copy" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="Performs cryptographic SHA-256 and byte-size checks to ensure file fidelity."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="1"
                                  IsOn="{x:Bind ViewModel.VerifyIntegrity, Mode=TwoWay}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"
                                  VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 4. Startup & System Integration Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="System Integration" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium" />
                            <TextBlock Text="Automatically launch iBackup minimized when you log into Windows."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                      OnContent="Yes"
                                      OffContent="No"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Minimize to system tray" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium" />
                            <TextBlock Text="Keep the application running quietly in the taskbar notification area."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      OnContent="Yes"
                                      OffContent="No"
                                      VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. About Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="About iBackup" Style="{ThemeResource BaseTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="A native Windows desktop utility for backing up iOS camera roll media over USB with deduplication and metadata preservation."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Version:" FontWeight="Medium" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <HyperlinkButton Content="iBackup on GitHub"
                                     NavigateUri="{x:Bind ViewModel.GitHubUrl, Mode=OneWay}"
                                     Padding="0,4" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
