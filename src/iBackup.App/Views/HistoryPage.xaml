<Page
    x:Class="iBackup.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:iBackup.App.Converters"
    xmlns:models="using:iBackup.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:BackupStatusToColorConverter x:Key="BackupStatusToColorConverter" />
    </Page.Resources>

    <Grid Margin="24,32,24,32" MaxWidth="800" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,28" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="History" Style="{StaticResource PageTitleStyle}"  TextWrapping="Wrap" />
                <TextBlock Text="Your backups, at a glance."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"  TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1" HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Padding="16,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="Refresh"  TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Empty State Container -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <FontIcon Glyph="&#xE81C;" FontSize="56"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No backup history yet"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"  TextWrapping="Wrap" />
            <TextBlock Text="Your first backup will appear here, with file counts and its completion status."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       MaxWidth="400"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Sessions ListView -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.BackupSessions, Mode=OneWay}"
                  SelectionMode="None"
                  Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BackupSession">
                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                            <!-- Device & Date Info -->
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind DeviceName}"
                                           Style="{ThemeResource BaseTextBlockStyle}"
                                           FontWeight="SemiBold"  TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind StartedAt}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"  TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- File Counts -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind TotalFiles}" FontWeight="SemiBold" Style="{ThemeResource BodyTextBlockStyle}"  TextWrapping="Wrap" />
                                    <TextBlock Text="total files" Style="{ThemeResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"  TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind NewFiles}" FontWeight="Medium" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}"  TextWrapping="Wrap" />
                                    <TextBlock Text="new" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  TextWrapping="Wrap" />
                                    <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind SkippedFiles}" FontWeight="Medium" Style="{ThemeResource CaptionTextBlockStyle}"  TextWrapping="Wrap" />
                                    <TextBlock Text="skipped" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"  TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Total Size -->
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource FileSizeConverter}}"
                                           FontWeight="SemiBold"
                                           Style="{ThemeResource BodyTextBlockStyle}"  TextWrapping="Wrap" />
                                <TextBlock Text="Total Size"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"  TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    BorderBrush="{x:Bind Status, Converter={StaticResource BackupStatusToColorConverter}}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="12"
                                    Padding="12,4">
                                <TextBlock Text="{x:Bind Status}"
                                           FontWeight="SemiBold"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{x:Bind Status, Converter={StaticResource BackupStatusToColorConverter}}"  TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
