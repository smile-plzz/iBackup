<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>iBackup.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\iBackup.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>0.1.4</Version>
    <AssemblyName>iBackup</AssemblyName>
    <Product>iBackup</Product>
    <Authors>Ismail Hossain</Authors>
    <RepositoryUrl>https://github.com/smile-plzz/iBackup</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\iBackup.Core\iBackup.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\iBackup-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\iBackup.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The WinUI build places the application's PRI and compiled XAML beside the
    normal build output, but dotnet publish does not include them for this
    unpackaged project. Without these files the process starts but cannot load
    MainWindow.xaml, leaving no visible window.
  -->
  <Target Name="CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIXbf Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    <Copy
      SourceFiles="@(_WinUIXbf)"
      DestinationFiles="@(_WinUIXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
